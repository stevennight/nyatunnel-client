{
  "name": "nyatunnel-gui",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "web:dev": "vite --host 127.0.0.1",
