{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NyaTunnel",
  "version": "../package.json",
  "identifier": "io.github.stevennight.nyatunnel",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NyaTunnel",
        "width": 960,
        "height": 640,
        "minWidth": 760,
        "minHeight": 440,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "NyaTunnel 客户端",
    "longDescription": "NyaTunnel 桌面客户端：注册到 NyaTunnel 服务器，运行管理员分配给本机的隧道。",
    "publisher": "stevennight",
    "homepage": "https://github.com/stevennight/nyatunnel-client",
    "externalBin": ["binaries/nyatunnel"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "windows/installer.nsi",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["nyatunnel"]
      }
    }
  }
}
